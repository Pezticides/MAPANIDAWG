{
  "extends": "expo/tsconfig.base.json",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "src/app/**/*",
    "src/lib/**/*",
    "data/**/*"
  ],
  "exclude": [
    "node_modules"
  ]
}
