
{
  "expo": {
    "name": "USTP Campus Navigator",
    "slug": "ustp-campus-navigator",
    "scheme": "ustpcampus",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/images/icon.png",
    "plugins": [
      "expo-router",
      "expo-location",
      "expo-status-bar",
      "expo-image",
      "expo-splash-screen",
      "expo-web-browser",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "-keep class * extends androidx.room.RoomDatabase { <init>(); }\n-keep class * extends androidx.work.InputMerger { <init>(); }"
          }
        }
      ]
    ],
    "android": {
      "package": "com.shem.ustpcampusnavigator",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.shem.ustpcampusnavigator"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "7fee950b-8ddf-4e8a-bccd-090495bd8e4e"
      }
    }
  }
}
